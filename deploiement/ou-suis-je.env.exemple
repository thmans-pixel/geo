# Copier vers /etc/ou-suis-je.env (chmod 600) et remplir. NE JAMAIS mettre ce fichier rempli dans le dépôt.
OUSUISJE_IMAGES=google
# Clé 1 : pour le navigateur (restreinte à https://geo.izicraft.fr/* ; API Maps JavaScript seulement)
OUSUISJE_GOOGLE_KEY=
# Clé 2 : pour le serveur (outil de réserve ; restreinte à l'API Street View Static / metadata)
OUSUISJE_GOOGLE_KEY_OUTIL=
OUSUISJE_BASE=/var/lib/ou-suis-je/jeu.sqlite3
OUSUISJE_RESERVES=/var/lib/ou-suis-je/reserves
# Identité : en-tête posé par SSOwat/nginx, identifiant de l'administrateur, secret partagé avec nginx
OUSUISJE_ENTETE=Remote-User
OUSUISJE_ADMIN=
OUSUISJE_SECRET_PROXY=
OUSUISJE_URL_CONNEXION=/yunohost/sso/
# Plafond d'images par jour (ceinture ; le vrai plafond est le quota chez Google)
OUSUISJE_PLAFOND_IMAGES=500
# Cookie marqué « secure » (le site est en https)
OUSUISJE_COOKIE_SECURE=1
